# Copy this file to .env and fill in the values. Never commit .env.

# ── Discord ──────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
TOKEN=

# Dev bot only: register commands to this one server (instant updates) instead of globally.
# Leave empty on the production bot.
DEV_GUILD_ID=

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/thevoid

# ── Atlas IP whitelisting (optional) ─────────────────────────────
# Only needed when the host's public IP changes. When all three are set, the bot adds its
# current IP to the Atlas access list on startup. Leave them empty on a static-IP host.
# The API key needs the "Project IP Access List Admin" role on the project.
MONGODB_PUBLIC_KEY=
MONGODB_PRIVATE_KEY=
MONGODB_PROJECT_ID=
# Comment used to tag (and later replace) the bot's own access-list entry
IP_DISCRIMINATOR=thevoid-bot

# ── Logging ──────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
